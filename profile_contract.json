{
  "version": 1,
  "type": "object",
  "required": [
    "character",
    "progress",
    "coins",
    "owned",
    "equipped",
    "quests"
  ],
  "properties": {
    "character": {
      "type": "object",
      "required": [
        "name",
        "class"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "class": {
          "enum": [
            "Banker",
            "Vampire",
            "Speedster",
            "Politician"
          ]
        },
        "choose_class": {
          "type": "boolean"
        }
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "level",
        "xp"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "xp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "rewarded_level": {
          "type": "number",
          "minimum": 0
        },
        "old_next": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "coins": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "owned": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vehicles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "equipped": {
      "type": "object",
      "values": {
        "type": "string"
      }
    },
    "presets": {
      "type": "object",
      "values": {
        "type": "object",
        "values": {
          "type": "string"
        }
      }
    },
    "consumables": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "hotbar_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tutorial": {
      "type": "boolean"
    },
    "city_intro": {
      "type": "boolean"
    },
    "growth": {
      "type": "object"
    },
    "world": {
      "type": "object"
    },
    "dungeon": {
      "type": "object"
    },
