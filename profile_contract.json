              "items": {
                "type": "string",
                "maxLength": 128
              }
            },
            "frontier_receipts": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            },
            "minigame_receipts": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
