      "type": "object"
    },
    "last_death": {
      "type": "object"
    },
    "sanctuary": {
      "type": "object"
    },
    "outing": {
      "type": "object"
    },
    "quests": {
      "type": "object",
      "properties": {
        "minigames": {
          "type": "object",
          "maxProperties": 4,
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
