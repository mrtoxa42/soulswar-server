              "best_wpm": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "best_accuracy": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "class_jobs": {
          "type": "object"
        },
        "vampire_jobs": {
          "type": "object"
        },
        "frontier_ledger": {
          "type": "object"
        },
        "city_guide": {
          "type": "object"
        },
        "world_journey": {
          "type": "object"
        },
        "simulation_opening": {
          "type": "object"
        },
        "world_landmarks": {
          "type": "object"
        },
        "class_realms": {
          "type": "object"
        },
        "world_jobs": {
          "type": "object"
        },
        "world_rest": {
          "type": "object"
        },
        "street_ready": {
          "type": "object"
        },
        "street_species": {
          "type": "object"
        },
        "dungeon_records": {
          "type": "object"
        },
        "dungeon_live": {
          "type": "object"
        },
        "parking_started": {
          "type": "boolean"
        },
        "parking_seal": {
          "type": "boolean"
        },
        "parking_return_pending": {
          "type": "boolean"
        },
        "parking_scooter_crafted": {
          "type": "boolean"
        },
        "street_bag": {
          "type": "boolean"
        },
        "street_bike": {
          "type": "boolean"
        },
        "street_quest_courier": {
          "type": "boolean"
        },
        "street_quest_ecology": {
          "type": "boolean"
        },
        "street_quest_elite": {
          "type": "boolean"
        },
        "parking_parts": {
          "type": "integer",
          "minimum": 0
        },
        "parking_completions": {
          "type": "integer",
          "minimum": 0
        },
        "street_scrap": {
          "type": "integer",
          "minimum": 0
        },
        "vampire_tracking": {
          "type": "string"
        },
        "world_tracking": {
          "enum": [
            "expedition",
            "training"
          ]
        },
        "city_raid_receipts": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
