            "wins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "br_wins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            }
          }
        },
        "minigame_receipts": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "pattern": "^(td|br|rc):.{36}$"
          }
        },
        "class_origin": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
